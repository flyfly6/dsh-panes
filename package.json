{
  "name": "dsh-panes",
  "version": "0.1.0",
  "description": "Tabbed workspace panel for DeepSeek Harness: a project sidebar with per-project tabs for session, files, search, terminal, browser, source control and notes",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client.bundle.js",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "screenshots.json",
    "assets",
    "src/git/LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "workbench",
    "tabs",
    "workspace",
    "ide"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfly6/dsh-panes.git"
  },
  "homepage": "https://github.com/flyfly6/dsh-panes#readme",
  "bugs": {
    "url": "https://github.com/flyfly6/dsh-panes/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:styles": "node scripts/build-styles.mjs",
    "build:client": "tsdown && node scripts/wrap-client.mjs",
    "build": "pnpm run build:styles && pnpm run build:client",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@blocknote/ariakit": "0.57.0",
    "@blocknote/core": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.66.0",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
